{
  "expo": {
    "androidStatusBar": {
      "hidden": true
    },
    "name": "CheckWord",
    "slug": "CheckWord",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./image/icon.png",
    "scheme": "checkword",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./image/icon.png",
        "backgroundImage": "./image/icon.png",
        "monochromeImage": "./image/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.stratege123456.checkword"
    },
    "web": {
      "output": "static",
      "favicon": "./image/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./image/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-audio",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5542646175321041~3495157292",
          "iosAppId": "ca-app-pub-5542646175321041~3495157292"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "25.1.8937393",
            "extraProjectAppIncludes": [],
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so"
              ]
            },
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c010e99-34aa-4d6d-9f36-0080ab277fb9"
      }
    }
  }
}
